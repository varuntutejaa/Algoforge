# MongoDB
MONGO_URI=mongodb+srv://...

# Firebase Admin SDK (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_CLIENT_CERT_URL=https://iam.googleapis.com/v1/projects/your-project/serviceAccounts/your-service-account%40your-project.iam.gserviceaccount.com

# Judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=your-judge0-api-key