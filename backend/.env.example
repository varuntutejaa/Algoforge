# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Supabase Postgres. Use the connection pooler — the direct
# db.<ref>.supabase.co endpoint is IPv6-only and unreachable from a lot of
# networks and hosts, including Vercel.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Firebase project id. Incoming ID tokens are verified against Google's public
# JWKS; the issuer must be https://securetoken.google.com/<this value> and the
# audience must equal it. No service-account key is needed.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Groq (AI hints and code review)
GROQ_API_KEY=your-groq-api-key

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Judge0. Defaults to the public CE instance when unset; an API key is needed
# for the rate-limited hosted plans or a self-hosted deployment.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Override the default Groq model.
GROQ_MODEL=

# Shared secret required in the X-Admin-Key header to create problems via the API.
ADMIN_API_KEY=your-random-admin-secret

# Postgres pool size per instance. Defaults to 2 on serverless and 10
# elsewhere. Raise it only if you know the pooler can take the extra
# connections — dozens of cold lambdas at 10 each will exhaust it.
DB_POOL_MAX=

# ---------------------------------------------------------------------------
# GitHub solution sync (all four required to enable the feature)
# ---------------------------------------------------------------------------

# 32 bytes, base64 or hex. Encrypts GitHub access tokens at rest (AES-256-GCM).
# Also used as the HMAC secret for the OAuth state parameter.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth app credentials. The callback must match the app registration
# exactly, or GitHub rejects the exchange.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/github/callback
