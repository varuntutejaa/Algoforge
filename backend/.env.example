# RDS PostgreSQL. When connecting through the SSH tunnel to the bastion during
# local development, add `&sslmode=require&uselibpqcompat=true` — RDS's CA
# chain isn't in the default trust store `pg`/libpq check against otherwise.
DATABASE_URL=postgresql://algoforge_admin:PASSWORD@your-rds-endpoint:5432/algoforge?schema=public

# AWS Cognito (created via infra/setup/create-cognito-user-pool.sh)
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-app-client-id

# Judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=your-judge0-api-key

# Groq (AI hints/review)
GROQ_API_KEY=your-groq-api-key

# Shared secret required in the X-Admin-Key header to create problems via POST /problems
ADMIN_API_KEY=your-random-admin-secret

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173