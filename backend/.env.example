# Supabase Postgres. Use the connection pooler (Session mode, port 5432) —
# the direct db.<ref>.supabase.co endpoint is IPv6-only and unreachable from
# a lot of networks/hosts.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project URL — used to verify access tokens against the project's
# public JWKS (Project Settings → API → Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=your-judge0-api-key

# Groq (AI hints/review)
GROQ_API_KEY=your-groq-api-key

# Shared secret required in the X-Admin-Key header to create problems via POST /problems
ADMIN_API_KEY=your-random-admin-secret

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
