{
  // Fail CI on any high/critical vulnerability in code that actually ships
  // to production (devDependencies like eslint/nodemon are skipped — see
  // --skip-dev).
  "$schema": "https://raw.githubusercontent.com/IBM/audit-ci/main/docs/schema.json",
  "high": true,
  "critical": true,
  "skip-dev": true,
  "allowlist": [
    // deepmerge-ts stack exhaustion (prisma > @prisma/config > deepmerge-ts,
    // pinned to an exact 7.1.5 — no semver range to bump within). Only
    // triggerable by merging attacker-controlled deeply-recursive objects;
    // @prisma/config only ever merges our own prisma.config.ts, at
    // build/dev time, never a live request. Remove once Prisma ships a
    // release pinning deepmerge-ts >=8.0.0.
    "GHSA-ggr8-5vv4-36mx"
  ]
}
