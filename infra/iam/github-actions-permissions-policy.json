{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ProdFrontendListBucket", "Effect": "Allow", "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::algoforge-frontend-472888338171" },
    { "Sid": "ProdFrontendObjects", "Effect": "Allow", "Action": ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::algoforge-frontend-472888338171/*" },
    { "Sid": "ProdFrontendInvalidation", "Effect": "Allow", "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::472888338171:distribution/E1UVHN2W0SQ452" },
    { "Sid": "ProdBackendSendCommand", "Effect": "Allow", "Action": ["ssm:SendCommand"],
      "Resource": [
        "arn:aws:ec2:ap-south-1:472888338171:instance/i-05242cb415eb164de",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
      ] },

    { "Sid": "StagingFrontendListBucket", "Effect": "Allow", "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<STAGING_S3_BUCKET_NAME>" },
    { "Sid": "StagingFrontendObjects", "Effect": "Allow", "Action": ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::<STAGING_S3_BUCKET_NAME>/*" },
    { "Sid": "StagingFrontendInvalidation", "Effect": "Allow", "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::472888338171:distribution/<STAGING_CLOUDFRONT_DISTRIBUTION_ID>" },
    { "Sid": "StagingBackendSendCommand", "Effect": "Allow", "Action": ["ssm:SendCommand"],
      "Resource": [
        "arn:aws:ec2:ap-south-1:472888338171:instance/<STAGING_EC2_INSTANCE_ID>",
        "arn:aws:ssm:ap-south-1::document/AWS-RunShellScript"
      ] },

    { "Sid": "BackendPollCommand", "Effect": "Allow", "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*" },

    { "Sid": "DeployArtifactsWrite", "Effect": "Allow", "Action": ["s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::algoforge-deploy-artifacts-472888338171",
        "arn:aws:s3:::algoforge-deploy-artifacts-472888338171/*"
      ] }
  ]
}
